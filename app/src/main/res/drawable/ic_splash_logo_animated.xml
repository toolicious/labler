<?xml version="1.0" encoding="utf-8"?>
<!-- Splash animation: the printer body is there from the start. The label card sits
     behind it, pulled into its cutout (translateX -20, see ic_splash_logo.xml). After a
     short delay it slides out of the cutout, which masks it into the right shape on the
     way. API 31+ only; MainActivity holds the splash a moment for it. -->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:drawable="@drawable/ic_splash_logo">
    <target android:name="labelGroup">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:propertyName="translateX"
                android:valueFrom="-20"
                android:valueTo="0"
                android:startOffset="150"
                android:duration="320"
                android:interpolator="@android:interpolator/decelerate_cubic" />
        </aapt:attr>
    </target>
</animated-vector>
